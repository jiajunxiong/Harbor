# 看板前端配置（复制为 .env.local 后按需修改）
#
# 只读令牌：与 API 的 HARBOR_API_TOKEN 一致。
# 该值会随前端构建产物下发，因此**只能**使用只读角色令牌，
# 绝不可使用运维（ops）令牌（MVP 5 / SP 5.4）。
VITE_HARBOR_API_TOKEN=

# API 地址前缀。留空表示同源（开发态由 Vite 代理 /api 到 HARBOR_API_TARGET）。
VITE_HARBOR_API_BASE_URL=

# 开发态 Vite 代理的后端地址。
HARBOR_API_TARGET=http://127.0.0.1:8000
