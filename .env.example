# Local development database and cache services
# Ports avoid the host services already bound to 5432/6379 on this machine.
POSTGRES_DB=harbor
POSTGRES_USER=harbor
POSTGRES_PASSWORD=harbor
POSTGRES_PORT=5433
REDIS_PORT=6383

# Harbor application settings
DATABASE_URL=postgresql+psycopg://harbor:harbor@localhost:5432/harbor
MARKET_TARGET=BOTH
DATA_PROVIDER_HK=mock
DATA_PROVIDER_US=mock
LOG_LEVEL=INFO